# Documentation only: export variables in your shell or deployment environment.
# Do not place credentials in source control. Node does not load this file automatically.
# Copy this gitignored template to .env for local npm run dev, or export vars in your environment.
# npm run dev loads .env into the API process only. Never commit real credentials.
API_PORT=3001
DATA_DIR=.data/postgres
SANDBOX_MODE=true
COOKIE_SECURE=false
COOKIE_EMBEDDED=false
# Only enable behind a trusted proxy that strips client-supplied X-Forwarded-For.
TRUST_PROXY=false
# Production sign-up is disabled by default. Enable only after identity/recovery controls are in place.
# PUBLIC_REGISTRATION_ENABLED=false
# DATABASE_URL is optional in local development; required for production.
# Live and sandbox deployments MUST use different databases.
# Paystack integration is disabled by default and test-only in a separate sandbox.
PAYSTACK_TEST_MODE=true
# To test: use only an sk_test_... secret and an HTTPS callback URL on the sandbox origin.
# PAYSTACK_SECRET_KEY=sk_test_e0d6a1049bcb727065dc80b32228e8f4362cc1db
# PAYSTACK_CALLBACK_URL=https://sandbox.example.invalid/verification
